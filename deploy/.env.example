# ── Sécurité ──────────────────────────────────────────────────────────────────
# Génère : python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# ── Concurrence ───────────────────────────────────────────────────────────────
# Instances Chrome pour Sushiscan (RAM ~300-500 Mo/instance). 2 = recherche jamais
# bloquée par un download. Sur Oracle A1 (24 Go) tu peux monter à 3-4.
SUSHISCAN_POOL_SIZE=2
# Ferme les navigateurs INACTIFS depuis N secondes (libère la RAM). 0 = jamais.
# Ne touche jamais une instance en cours d'usage ; la réutilisation à chaud reste active.
SUSHISCAN_IDLE_TIMEOUT=600
# Workers de jobs (téléchargements simultanés, toutes sources).
JOB_WORKERS=3

# ── Chromium ──────────────────────────────────────────────────────────────────
CHROME_BIN=/usr/bin/chromium

# ── Base de données ───────────────────────────────────────────────────────────
# SQLite par défaut (fichier sur volume persistant). Laisser vide sauf migration Postgres.
# DB_PATH=/srv/app/api/data/app.db
# DATABASE_URL=postgres://user:pass@host/db   # (futur, Neon/Supabase)

# ── Stockage Telegram (MTProto) ───────────────────────────────────────────────
# local  = EPUB gardés sur le disque (défaut)
# telegram = offload vers Telegram (recommandé en prod : disque gratuit limité)
STORAGE_BACKEND=local
# https://my.telegram.org → API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# @canal_prive ou id numérique du canal de stockage
TELEGRAM_CHANNEL=
# Généré une fois via : python scripts/telegram_login.py
TELEGRAM_SESSION=/srv/app/api/data/tg.session
# Cache local des EPUB après upload (secondes). 0 = supprime tout de suite.
LOCAL_CACHE_TTL=86400
